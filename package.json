{
  "name": "milky-mart-local-clone",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "test:report": "playwright show-report",
    "preflight": "node scripts/preflight.mjs",
    "sync": "npm run build && cap sync android",
    "apk": "npm run preflight && npm run sync && cd android && ./gradlew assembleDebug",
    "apk:release": "npm run preflight && npm run sync && cd android && ./gradlew assembleRelease",
    "aab:release": "npm run preflight && npm run sync && cd android && ./gradlew bundleRelease",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.3.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/status-bar": "^8.0.3",
    "firebase": "^12.16.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-react": "^6.0.3",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
